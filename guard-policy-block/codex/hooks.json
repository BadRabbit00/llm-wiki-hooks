{
  "description": "llm-wiki: защита сгенерированного блока политик",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook guard-block",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
